import 'package:flutter/material.dart';
import 'package:just_audio/just_audio.dart';

void main() {
  runApp(const MusicPlayerApp());
}

class MusicPlayerApp extends StatelessWidget {
  const MusicPlayerApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      debugShowCheckedModeBanner: false,
      title: 'Music Player',
      theme: ThemeData.dark().copyWith(
        scaffoldBackgroundColor: const Color(0xFF101018),
        colorScheme: ColorScheme.fromSeed(
          seedColor: Colors.purpleAccent,
          brightness: Brightness.dark,
        ),
      ),
      home: const MusicHomePage(),
    );
  }
}

class Song {
  final String title;
  final String artist;
  final String asset;
  final Color color;

  const Song({
    required this.title,
    required this.artist,
    required this.asset,
    required this.color,
  });
}

class MusicHomePage extends StatefulWidget {
  const MusicHomePage({super.key});

  @override
  State<MusicHomePage> createState() => _MusicHomePageState();
}

class _MusicHomePageState extends State<MusicHomePage> {
  final AudioPlayer _player = AudioPlayer();

  final List<Song> songs = const [
    Song(
      title: 'Dreams',
      artist: 'Chill Music',
      asset: 'assets/music/song1.mp3',
      color: Color(0xFF7C4DFF),
    ),
    Song(
      title: 'Midnight Vibes',
      artist: 'Relaxing Beats',
      asset: 'assets/music/song2.mp3',
      color: Color(0xFF00BFA5),
    ),
    Song(
      title: 'Summer Lights',
      artist: 'Pop Station',
      asset: 'assets/music/song3.mp3',
      color: Color(0xFFFF7043),
    ),
  ];

  int currentIndex = 0;
  bool isLoading = false;
  String? errorMessage;

  Song get currentSong => songs[currentIndex];

  @override
  void initState() {
    super.initState();
    _loadSong(0, autoPlay: false);
  }

  Future<void> _loadSong(
    int index, {
    bool autoPlay = true,
  }) async {
    setState(() {
      currentIndex = index;
      isLoading = true;
      errorMessage = null;
    });

    try {
      await _player.setAsset(songs[index].asset);

      if (autoPlay) {
        await _player.play();
      }
    } catch (e) {
      if (mounted) {
        setState(() {
          errorMessage =
              'Unable to load song. Check your MP3 files and asset paths.';
        });
      }
    } finally {
      if (mounted) {
        setState(() {
          isLoading = false;
        });
      }
    }
  }

  Future<void> _togglePlay() async {
    if (isLoading) return;

    try {
      if (_player.playing) {
        await _player.pause();
      } else {
        if (_player.processingState == ProcessingState.completed) {
          await _player.seek(Duration.zero);
        }
        await _player.play();
      }
    } catch (e) {
      if (mounted) {
        setState(() {
          errorMessage = 'Unable to play this song.';
        });
      }
    }
  }

  Future<void> _nextSong() async {
    final nextIndex = (currentIndex + 1) % songs.length;
    await _loadSong(nextIndex);
  }

  Future<void> _previousSong() async {
    final previousIndex =
        (currentIndex - 1 + songs.length) % songs.length;
    await _loadSong(previousIndex);
  }

  String _formatDuration(Duration duration) {
    final minutes = duration.inMinutes;
    final seconds = duration.inSeconds % 60;

    return '$minutes:${seconds.toString().padLeft(2, '0')}';
  }

  @override
  void dispose() {
    _player.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        backgroundColor: const Color(0xFF101018),
        centerTitle: true,
        title: const Text(
          'MUSIC PLAYER',
          style: TextStyle(
            fontSize: 17,
            fontWeight: FontWeight.bold,
            letterSpacing: 3,
          ),
        ),
        actions: const [
          Padding(
            padding: EdgeInsets.only(right: 16),
            child: Icon(Icons.graphic_eq, color: Colors.purpleAccent),
          ),
        ],
      ),
      body: SafeArea(
        child: Column(
          children: [
            const SizedBox(height: 10),
            const Text(
              'Feel the music',
              style: TextStyle(
                color: Colors.white54,
                fontSize: 15,
              ),
            ),
            const SizedBox(height: 24),

            // Album artwork
            Container(
              width: 260,
              height: 260,
              decoration: BoxDecoration(
                gradient: LinearGradient(
                  colors: [
                    currentSong.color,
                    const Color(0xFF222233),
                  ],
                  begin: Alignment.topLeft,
                  end: Alignment.bottomRight,
                ),
                borderRadius: BorderRadius.circular(32),
                boxShadow: [
                  BoxShadow(
                    color: currentSong.color.withValues(alpha: 0.25),
                    blurRadius: 30,
                    spreadRadius: 2,
                  ),
                ],
              ),
              child: const Icon(
                Icons.music_note_rounded,
                size: 130,
                color: Colors.white,
              ),
            ),

            const SizedBox(height: 28),

            Text(
              currentSong.title,
              style: const TextStyle(
                fontSize: 25,
                fontWeight: FontWeight.bold,
              ),
            ),
            const SizedBox(height: 8),
            Text(
              currentSong.artist,
              style: const TextStyle(
                fontSize: 15,
                color: Colors.white54,
              ),
            ),

            const SizedBox(height: 22),

            // Progress slider
            Padding(
              padding: const EdgeInsets.symmetric(horizontal: 24),
              child: StreamBuilder<Duration>(
                stream: _player.positionStream,
                builder: (context, positionSnapshot) {
                  final position =
                      positionSnapshot.data ?? Duration.zero;

                  return StreamBuilder<Duration?>(
                    stream: _player.durationStream,
                    builder: (context, durationSnapshot) {
                      final duration =
                          durationSnapshot.data ?? Duration.zero;

                      final maxSeconds =
                          duration.inSeconds.toDouble();

                      final positionSeconds =
                          position.inSeconds.toDouble();

                      return Column(
                        children: [
                          Slider(
                            value: maxSeconds > 0
                                ? positionSeconds
                                    .clamp(0.0, maxSeconds)
                                    .toDouble()
                                : 0.0,
                            max: maxSeconds > 0 ? maxSeconds : 1.0,
                            activeColor: Colors.purpleAccent,
                            inactiveColor: Colors.white12,
                            onChanged: maxSeconds > 0
                                ? (value) {
                                    _player.seek(
                                      Duration(
                                        seconds: value.round(),
                                      ),
                                    );
                                  }
                                : null,
                          ),
                          Padding(
                            padding: const EdgeInsets.symmetric(
                              horizontal: 12,
                            ),
                            child: Row(
                              mainAxisAlignment:
                                  MainAxisAlignment.spaceBetween,
                              children: [
                                Text(
                                  _formatDuration(position),
                                  style: const TextStyle(
                                    color: Colors.white54,
                                    fontSize: 12,
                                  ),
                                ),
                                Text(
                                  _formatDuration(duration),
                                  style: const TextStyle(
                                    color: Colors.white54,
                                    fontSize: 12,
                                  ),
                                ),
                              ],
                            ),
                          ),
                        ],
                      );
                    },
                  );
                },
              ),
            ),

            const SizedBox(height: 12),

            // Playback controls
            Row(
              mainAxisAlignment: MainAxisAlignment.center,
              children: [
                IconButton(
                  onPressed: _previousSong,
                  icon: const Icon(Icons.skip_previous_rounded),
                  iconSize: 42,
                ),
                const SizedBox(width: 20),
                StreamBuilder<PlayerState>(
                  stream: _player.playerStateStream,
                  builder: (context, snapshot) {
                    final playing =
                        snapshot.data?.playing ?? false;

                    return Container(
                      width: 70,
                      height: 70,
                      decoration: const BoxDecoration(
                        color: Colors.purpleAccent,
                        shape: BoxShape.circle,
                      ),
                      child: IconButton(
                        onPressed: _togglePlay,
                        icon: Icon(
                          isLoading
                              ? Icons.hourglass_empty
                              : playing
                                  ? Icons.pause_rounded
                                  : Icons.play_arrow_rounded,
                          color: Colors.white,
                        ),
                        iconSize: 42,
                      ),
                    );
                  },
                ),
                const SizedBox(width: 20),
                IconButton(
                  onPressed: _nextSong,
                  icon: const Icon(Icons.skip_next_rounded),
                  iconSize: 42,
                ),
              ],
            ),

            if (errorMessage != null)
              Padding(
                padding: const EdgeInsets.all(8),
                child: Text(
                  errorMessage!,
                  textAlign: TextAlign.center,
                  style: const TextStyle(color: Colors.redAccent),
                ),
              ),

            const SizedBox(height: 20),

            // Playlist
            const Padding(
              padding: EdgeInsets.symmetric(horizontal: 20),
              child: Align(
                alignment: Alignment.centerLeft,
                child: Text(
                  'UP NEXT',
                  style: TextStyle(
                    fontWeight: FontWeight.bold,
                    letterSpacing: 2,
                    fontSize: 13,
                    color: Colors.white70,
                  ),
                ),
              ),
            ),

            const SizedBox(height: 8),

            Expanded(
              child: ListView.builder(
                padding: const EdgeInsets.symmetric(horizontal: 12),
                itemCount: songs.length,
                itemBuilder: (context, index) {
                  final song = songs[index];
                  final selected = index == currentIndex;

                  return Card(
                    color: selected
                        ? const Color(0xFF29213B)
                        : const Color(0xFF191923),
                    shape: RoundedRectangleBorder(
                      borderRadius: BorderRadius.circular(16),
                    ),
                    child: ListTile(
                      leading: Container(
                        width: 46,
                        height: 46,
                        decoration: BoxDecoration(
                          color: song.color,
                          borderRadius: BorderRadius.circular(12),
                        ),
                        child: const Icon(
                          Icons.music_note,
                          color: Colors.white,
                        ),
                      ),
                      title: Text(
                        song.title,
                        style: TextStyle(
                          fontWeight: FontWeight.bold,
                          color: selected
                              ? Colors.purpleAccent
                              : Colors.white,
                        ),
                      ),
                      subtitle: Text(song.artist),
                      trailing: selected
                          ? const Icon(
                              Icons.equalizer,
                              color: Colors.purpleAccent,
                            )
                          : const Icon(
                              Icons.play_circle_outline,
                              color: Colors.white54,
                            ),
                      onTap: () => _loadSong(index),
                    ),
                  );
                },
              ),
            ),
          ],
        ),
      ),
    );
  }
}
